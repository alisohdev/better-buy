{
  "name": "better-buy",
  "private": true,
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -n api,web -c yellow,cyan \"pnpm --filter @better-buy/worker dev\" \"pnpm --filter @better-buy/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:wishlist": "pnpm --filter @better-buy/worker exec vitest run src/wishlist.test.ts src/wishlist-scheduler.test.ts src/test-login.integration.test.ts",
    "wishlist:scan": "node scripts/wishlist-scan.mjs",
    "test:e2e": "pnpm --filter @better-buy/web test:e2e",
    "cf:dev": "pnpm --filter @better-buy/worker dev",
    "cf:deploy": "pnpm --filter @better-buy/worker run deploy"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
