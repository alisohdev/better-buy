# Go API process configuration. Load these into the process environment.
VPS_DATABASE_PATH=../../.data/better-buy-vps.sqlite
VPS_HTTP_HOST=127.0.0.1
VPS_HTTP_PORT=8787
BETTER_AUTH_URL=http://127.0.0.1:8787
APP_ORIGIN=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=<set-a-random-secret>
BOX_KEY=<set-a-random-key>
# Optional admin dashboard. Only these verified emails are allowed; empty disables admin access.
WISHLIST_SCHEDULE_ENABLED=true
API_RATE_LIMITS_ENABLED=true
SNAPP_STORE_CAMPAIGNS_ENABLED=false
# Fresh supermarket scan is disabled until a local canary is reviewed.
DIGIKALA_SUPERMARKET_ENABLED=false
NEXT_PUBLIC_DIGIKALA_SUPERMARKET_ENABLED=false
DEV_MODE=false
# Optional settings for the daily Go SQLite backup command/service.
# VPS_BACKUP_DIR=../../.data/vps-backups
# VPS_BACKUP_RETENTION_DAYS=14
# Optional browser push. Set all three values together.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Phone authentication (backend only). For local development use SMS_PROVIDER=mock and DEV_MODE=true.
SMS_PROVIDER=iranpayamak
OTP_SECRET=
OTP_SMS_DOMAIN=better-buy.ir
SMS_TEMPLATE_WEBOTP_APPROVED=false
IRANPAYAMAK_API_KEY=
IRANPAYAMAK_PATTERN_CODE=
IRANPAYAMAK_SENDER_LINE=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_PATTERN_ID=
ADMIN_PHONES=
