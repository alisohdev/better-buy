better-buy.ir {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv/better-buy/current/apps/web/out

		handle /sw.js {
			header Cache-Control "no-cache"
			file_server
		}

		@hashedAsset {
			path /assets/*
			file
		}
		handle @hashedAsset {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@missingAsset path /assets/*
		handle @missingAsset {
			header Cache-Control "no-store"
			respond 404
		}

		@staticFile {
			path_regexp staticFile \.((js|mjs|css|woff2?|png|jpe?g|webp|svg|ico|webmanifest|json))$
		}
		handle @staticFile {
			file_server
		}

		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
