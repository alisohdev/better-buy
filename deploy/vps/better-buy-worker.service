[Unit]
Description=Better Buy persistent scan worker
After=network-online.target better-buy-http.service
Wants=network-online.target

[Service]
Type=simple
User=better-buy
Group=better-buy
WorkingDirectory=/srv/better-buy/current/apps/worker
EnvironmentFile=/etc/better-buy/better-buy.env
Environment=HOME=/var/lib/better-buy
Environment=NODE_ENV=production
ExecStart=/usr/bin/flock --nonblock --no-fork /var/lib/better-buy/scan-worker.lock /usr/local/bin/bun run --no-env-file vps/worker.ts
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/better-buy
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
