[Unit]
Description=Better Buy HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=better-buy
Group=better-buy
WorkingDirectory=/srv/better-buy/current/apps/worker
EnvironmentFile=/etc/better-buy/better-buy.env
Environment=HOME=/var/lib/better-buy
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/bun run --no-env-file vps/http.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/better-buy
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
