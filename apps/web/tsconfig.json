{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "routeTree.gen.ts"
  ],
  "exclude": ["node_modules", "out"]
}
