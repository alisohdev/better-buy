# Browser requests stay on the page's origin. Next dev proxies /api to the Worker.
# This lets session cookies work with both localhost:3000 and 127.0.0.1:3000.
# Copy to `.env.development` (NOT `.env.local`) so production `next build` stays same-origin.
DEV_API_ORIGIN=http://127.0.0.1:8787
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_AUTH_BASE_URL=
